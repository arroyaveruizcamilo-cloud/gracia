# ─── GRACIA — Configuración ───────────────────────────────────
# Copiá este archivo como .env y completá los valores.
# Este archivo NO se commitea. En producción las variables van en el panel de Render.

# JWT Secret — OBLIGATORIO en producción, mínimo 32 caracteres y seguro.
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=aqui-tu-secret-generado

# Base de datos
# Para SQLite (desarrollo):
# DATABASE_URL=sqlite:///./gracia.db
# Para PostgreSQL (producción):
DATABASE_URL=sqlite:///./gracia.db

# CORS — orígenes permitidos (separados por coma)
# En producción, poné el dominio de tu frontend
CORS_ORIGINS=http://localhost:5000

# Entorno (development | production)
ENVIRONMENT=development

# Puerto del servidor
PORT=5000

# Host
HOST=0.0.0.0

# Frontend URL (para emails)
FRONTEND_URL=http://localhost:5000

# Backend URL (para webhooks de MercadoPago — en producción debe ser tu URL real)
BACKEND_URL=http://localhost:5000

# ─── Emails (OBLIGATORIO en producción: el app no arranca sin ellos) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=tu-contraseña-de-app (Gmail: https://myaccount.google.com/apppasswords)
# FROM_EMAIL=noreply@gracia.moda

# ─── MercadoPago (para cobrar de verdad) ───────────────────────
# MP_ACCESS_TOKEN=TEST-xxxxxxxx
# MP_WEBHOOK_SECRET=xxxxxxxx

# ─── Almacenamiento de imágenes ────────────────────────────────
# local (default, disco efímero) | cloudinary | s3
# STORAGE_BACKEND=cloudinary
# CLOUDINARY_CLOUD_NAME=xxx
# CLOUDINARY_API_KEY=xxx
# CLOUDINARY_API_SECRET=xxx
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_BUCKET=xxx
# AWS_REGION=us-east-1

# ─── Rate limiting compartido (opcional) ───────────────────────
# REDIS_URL=redis://default:pass@host:6379

# ─── Admin inicial (solo primer arranque en producción) ────────
# SEED_ADMIN_EMAIL=admin@tu-dominio.com
# SEED_ADMIN_PASSWORD=contraseña-fuerte

# ─── Monitoreo de errores (opcional) ───────────────────────────
# SENTRY_DSN=https://xxxxxxxx@sentry.io/123

# ─── Google reCAPTCHA (protección login admin) ─────────────────
# Obtené tus keys en: https://www.google.com/recaptcha/admin
# Si no se configuran, reCAPTCHA se desactiva (solo dev)
# RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Envío (calculado en servidor) ─────────────────────────────
# SHIPPING_COST=0
# FREE_SHIPPING_MIN=0
