# ─── GRACIA — Configuración ───────────────────────────────────
# Copiá este archivo como .env y completá los valores.

# JWT Secret — CAMBIALO en producción por un valor seguro
# Podés generar uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=gracia-secret-key-2026

# Base de datos
# Para SQLite (desarrollo):
# DATABASE_URL=sqlite:///./gracia.db
# Para PostgreSQL (producción):
DATABASE_URL=sqlite:///./gracia.db

# CORS — orígenes permitidos (separados por coma)
# En producción, poné el dominio de tu frontend
CORS_ORIGINS=http://localhost:5000

# Entorno (development | production)
ENVIRONMENT=development

# Puerto del servidor
PORT=5000

# Host
HOST=0.0.0.0

# Frontend URL (para emails)
FRONTEND_URL=http://localhost:5000

# SMTP (opcional, para password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=tu-contraseña
# FROM_EMAIL=noreply@gracia.moda
